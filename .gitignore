# Secrets
.env
*.key

# Data (raw API cache + derived tables) — keep the folders, ignore contents
data/raw/*
!data/raw/.gitkeep
data/derived/*
!data/derived/.gitkeep

# Cached Data Dragon assets (downloaded on demand)
assets/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
build/
dist/
*.egg-info/

# OS / IDE
.DS_Store
Thumbs.db

# Discord server guideline text (third-party, private server) — local only
docs/discord/
# Lane-guide PNG/PDF docs + their build sources (derived from the private
# Discord guides) — local only, hand out directly to players
docs/guides/
