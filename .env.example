# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Get a key at https://developer.riotgames.com (dev keys rotate every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Gates the "管理者用" key-update panel in the sidebar. Pick your own value —
# also set it in the Streamlit Cloud app's Secrets to match.
ADMIN_PASSWORD=changeme
